# OpsPilot environment example — copy to .env and adjust as needed.
# Never commit real secrets.

APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+pymysql://opspilot:opspilot@localhost:3306/opspilot

JWT_SECRET_KEY=change-me-opspilot-demo-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Stripe sandbox (test mode). Leave placeholders to use local demo checkout.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_CURRENCY=usd

SEED_ADMIN_EMAIL=admin@opspilot.demo
SEED_ADMIN_PASSWORD=AdminDemo123!
SEED_CUSTOMER_PASSWORD=CustomerDemo123!

# Optional SMTP for support reply emails (leave blank to log emails in demo mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@opspilot.demo
SMTP_USE_TLS=true

# Daily fulfillment simulator — one status step per paid order per interval
# Development default: 10 minutes. Production default: 60 minutes.
FULFILLMENT_CRON_ENABLED=true
# FULFILLMENT_ADVANCE_INTERVAL_MINUTES=10

NEXT_PUBLIC_API_URL=http://localhost:8000
